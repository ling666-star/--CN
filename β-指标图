def get_pareto_front(df, x_col="beta", y_col="mae"):
    """
    对于“越小越好”的二维目标，提取 Pareto front。
    这里假设:
      - x_col 越小越好
      - y_col 越小越好
    """
    if len(df) == 0:
        return df.copy()

    tmp = df[[x_col, y_col]].copy().reset_index(drop=False)
    keep_idx = []

    for i, row_i in tmp.iterrows():
        dominated = False
        for j, row_j in tmp.iterrows():
            if i == j:
                continue

            # j 支配 i：两个指标都不差，且至少一个更好
            if (
                row_j[x_col] <= row_i[x_col]
                and row_j[y_col] <= row_i[y_col]
                and (
                    row_j[x_col] < row_i[x_col]
                    or row_j[y_col] < row_i[y_col]
                )
            ):
                dominated = True
                break

        if not dominated:
            keep_idx.append(row_i["index"])

    front = df.loc[keep_idx].copy()
    front = front.sort_values([x_col, y_col]).reset_index(drop=True)
    return front

def plot_beta_metric_facets_pareto(
    df,
    alpha=0.05,
    metric="mae",
    only_cn=False,
    save_path=None,
    title_prefix=""
):
    sub = df[df["alpha"] == alpha].copy()

    if only_cn:
        sub = sub[sub["model"] == "CN"].copy()

    sub = sub[~sub[metric].isna()].copy()

    if len(sub) == 0:
        print(f"No data for alpha={alpha}, metric={metric}")
        return

    M_values = sorted(sub["M"].unique())
    E_values = sorted(sub["E"].unique())

    n_rows = len(M_values)
    n_cols = len(E_values)

    fig, axes = plt.subplots(
        n_rows, n_cols,
        figsize=(5 * n_cols, 4 * n_rows),
        squeeze=False
    )

    legend_added = False

    for i, M_val in enumerate(M_values):
        for j, E_val in enumerate(E_values):
            ax = axes[i, j]

            cell = sub[(sub["M"] == M_val) & (sub["E"] == E_val)].copy()

            if len(cell) == 0:
                ax.set_visible(False)
                continue

            # -------------------------
            # BN：通常就是 baseline 点
            # -------------------------
            if not only_cn:
                bn_sub = cell[cell["model"] == "BN"].copy()
                if len(bn_sub) > 0:
                    ax.scatter(
                        bn_sub["beta"], bn_sub[metric],
                        marker="^",
                        color="red",
                        s=90,
                        label="BN" if not legend_added else None,
                        zorder=4
                    )

            # -------------------------
            # noisy BN：原始点 + Pareto front
            # -------------------------
            if not only_cn:
                noisy_sub = cell[cell["model"] == "noisyBN"].copy().sort_values("privacy_param")
                if len(noisy_sub) > 0:
                    # 原始点淡淡显示
                    ax.scatter(
                        noisy_sub["beta"], noisy_sub[metric],
                        color="blue",
                        s=28,
                        alpha=0.35,
                        zorder=1
                    )

                    noisy_front = get_pareto_front(noisy_sub, x_col="beta", y_col=metric)

                    if len(noisy_front) > 0:
                        ax.plot(
                            noisy_front["beta"], noisy_front[metric],
                            color="blue",
                            linestyle="--",
                            marker="o",
                            label="noisy BN" if not legend_added else None,
                            zorder=3
                        )

                        for _, row in noisy_front.iterrows():
                            ax.annotate(
                                row["privacy_label"],
                                (row["beta"], row[metric]),
                                textcoords="offset points",
                                xytext=(4, 4),
                                fontsize=7
                            )

            # -------------------------
            # CN：原始点 + Pareto front
            # -------------------------
            cn_sub = cell[cell["model"] == "CN"].copy().sort_values("privacy_param")
            if len(cn_sub) > 0:
                # 原始点淡淡显示
                ax.scatter(
                    cn_sub["beta"], cn_sub[metric],
                    color="#D8B7E8",
                    s=28,
                    alpha=0.35,
                    zorder=1
                )

                cn_front = get_pareto_front(cn_sub, x_col="beta", y_col=metric)

                if len(cn_front) > 0:
                    ax.plot(
                        cn_front["beta"], cn_front[metric],
                        color="#D8B7E8",
                        linestyle="-",
                        marker="o",
                        label="CN" if not legend_added else None,
                        zorder=3
                    )

                    for _, row in cn_front.iterrows():
                        ax.annotate(
                            row["privacy_label"],
                            (row["beta"], row[metric]),
                            textcoords="offset points",
                            xytext=(4, 4),
                            fontsize=7
                        )

            ax.set_title(f"M={M_val}, E={E_val}")
            ax.set_xlabel("Attack power β")
            ax.set_ylabel(metric.upper())
            ax.grid(True, linestyle="--", alpha=0.5)
            ax.tick_params(axis="x", labelrotation=45, labelsize=9)

            if not legend_added:
                ax.legend()
                legend_added = True

    plt.suptitle(f"{title_prefix} (alpha={alpha})", y=1.02, fontsize=14)
    plt.tight_layout()

    if save_path is not None:
        plt.savefig(save_path, dpi=300, bbox_inches="tight")
        print("Saved figure:", save_path)

    plt.show()

