def get_power(llr_ref, llr_gen, ground_truth, error):
    t = np.quantile(llr_ref, 1 - error).item()
    y_pred = llr_gen > t
    power = np.sum(ground_truth & y_pred) / np.sum(ground_truth)
    return float(power)


def run_mia(model_ie, baseline_ie, rpop, gpop_eval, ground_truth, error_vec):
    llr_ref = (
        rpop.apply(lambda x: get_llr(x.to_dict(), baseline_ie, model_ie), axis=1)
        .dropna()
        .sort_values()
    )

    llr_gen = gpop_eval[[*rpop.columns]].apply(
        lambda x: get_llr(x.to_dict(), baseline_ie, model_ie), axis=1
    )

    power_vec = []
    for error in error_vec:
        power = get_power(llr_ref, llr_gen, ground_truth, error)
        power_vec.append(power)

    auc = metrics.auc(error_vec, power_vec)
    return power_vec, auc, llr_ref, llr_gen


def get_maxll_bn(bns_sample, rpop):
    maxll_bn = None
    maxll = -np.inf

    for bn_tmp in bns_sample:
        bn_ie = gum.LazyPropagation(bn_tmp)
        ll_vec = rpop.apply(lambda x: get_ll(x.to_dict(), bn_ie), axis=1).dropna()
        ll_sum = np.sum(ll_vec)

        if ll_sum > maxll:
            maxll_bn = bn_tmp
            maxll = ll_sum

    return maxll_bn

