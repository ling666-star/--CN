def run_exp2_one_network(exp_name):
    print("\n" + "=" * 70)
    print("Running:", exp_name)
    print("=" * 70)

    # ----- load data -----
    current_meta = pd.read_csv(dags_path / f"{exp_name}_meta.csv").iloc[0].to_dict()

    gt_bn = gum.loadBN(str(bns_path / f"{exp_name}.bif"))
    gpop = pd.read_csv(data_path / f"{exp_name}.csv")
    train_df = pd.read_csv(splits_path / exp_name / "train_T.csv")
    ref_df = pd.read_csv(splits_path / exp_name / "ref_R.csv")
    test_df = pd.read_csv(splits_path / exp_name / "test_Q.csv")  # kept for consistency

    n_nodes_cur = int(current_meta["n_nodes"])
    n_arcs_cur = int(current_meta["n_arcs"])
    complexity_cur = float(current_meta["complexity"])
    E_cur = int(round(n_arcs_cur / n_nodes_cur))

    print("BN variable names:", gt_bn.names())
    print("gpop columns:", gpop.columns.tolist())
    print("ref_df columns:", ref_df.columns.tolist())

    print("Current experiment:")
    print("exp_name   =", exp_name)
    print("M          =", n_nodes_cur)
    print("E          =", E_cur)
    print("complexity =", complexity_cur)
    print("gpop size  =", len(gpop))
    print("train size =", len(train_df))
    print("ref size   =", len(ref_df))
    print("test size  =", len(test_df))

    # ----- ground truth labels: match by row_id, not by value -----
    if "row_id" not in gpop.columns:
        raise ValueError(f"{exp_name}.csv 中缺少 row_id 列，请先重新生成 P/T/R/Q 并保留 row_id")
    if "row_id" not in train_df.columns:
        raise ValueError(f"{exp_name}/train_T.csv 中缺少 row_id 列，请先重新生成 split 文件并保留 row_id")
    if "row_id" not in ref_df.columns:
        raise ValueError(f"{exp_name}/ref_R.csv 中缺少 row_id 列，请先重新生成 split 文件并保留 row_id")
    if "row_id" not in test_df.columns:
        raise ValueError(f"{exp_name}/test_Q.csv 中缺少 row_id 列，请先重新生成 split 文件并保留 row_id")

    train_ids = set(train_df["row_id"].tolist())

    gpop_eval = gpop.copy()
    gpop_eval["in_train_T"] = gpop_eval["row_id"].isin(train_ids)

    ground_truth_fixed = gpop_eval["in_train_T"].values.astype(bool)

    # 只把真正的变量列送进模型，去掉 row_id
    feature_cols = [c for c in gpop.columns if c != "row_id"]

    gpop_eval_vars = gpop_eval[feature_cols].copy()
    ref_df = ref_df[feature_cols].copy()
    train_df = train_df[feature_cols].copy()
    test_df = test_df[feature_cols].copy()

    print("Members in fixed T found in P:", ground_truth_fixed.sum())
    print("Non-members in fixed P:", len(ground_truth_fixed) - ground_truth_fixed.sum())

    # baseline from fixed R and learned BN from fixed T
    # save feature-only tables to normal csv files, then let pyAgrum read them

    ref_tmp_path = exp2_detail_path / f"{exp_name}_ref_features.csv"
    train_tmp_path = exp2_detail_path / f"{exp_name}_train_features.csv"

    ref_df.to_csv(ref_tmp_path, index=False)
    train_df.to_csv(train_tmp_path, index=False)

    ref_learner = gum.BNLearner(str(ref_tmp_path))
    ref_learner.useSmoothingPrior(1e-5)
    bn_ref = ref_learner.learnParameters(gt_bn.dag())
    bn_ref_ie = gum.LazyPropagation(bn_ref)

    train_learner = gum.BNLearner(str(train_tmp_path))
    train_learner.useSmoothingPrior(1e-5)
    bn_learned = train_learner.learnParameters(gt_bn.dag())

    print("Fixed baseline BN from R learned.")
    print("Fixed learned BN from T learned.")
    print("bn_ref names    =", bn_ref.names())
    print("bn_learned names=", bn_learned.names())

    # ----- map to network_id -----
    network_map = {
        (10, 1): 1,
        (10, 2): 2,
        (10, 4): 3,
        (20, 1): 4,
        (20, 2): 5,
        (20, 4): 6,
    }

    network_id = network_map.get((n_nodes_cur, E_cur), None)
    if network_id is None:
        raise ValueError(
            f"无法根据当前实验映射到论文网络序号: M={n_nodes_cur}, E={E_cur}"
        )

    print("Matched thesis network_id =", network_id)

    # ----- utility table for this network -----
    utility_df = utility_df_all_global[
        utility_df_all_global["network_id"] == network_id
    ].copy()

    # BN keep only one row to avoid one-to-many merge
    bn_row = (
        utility_df[utility_df["model"] == "BN"]
        .sort_values("level")
        .iloc[[0]]
        .copy()
    )

    non_bn_rows = utility_df[utility_df["model"] != "BN"].copy()
    utility_df = pd.concat([bn_row, non_bn_rows], axis=0, ignore_index=True)
    utility_df = utility_df.drop(columns=["network_id", "level"])

    utility_df["model"] = utility_df["model"].astype(str)
    utility_df["privacy_param_name"] = utility_df["privacy_param_name"].astype(str)
    utility_df["privacy_param"] = utility_df["privacy_param"].astype(float)

    # ----- main attack loop -----
    attack_rows = []

    # BN baseline
    print("[Exp2] BN baseline attack ...")

    bn_model_ie = gum.LazyPropagation(bn_learned)
    power_bn_vec, auc_bn, llr_ref_bn, llr_gen_bn = run_mia(
        model_ie=bn_model_ie,
        baseline_ie=bn_ref_ie,
        rpop=ref_df,
        gpop_eval=gpop_eval_vars,
        ground_truth=ground_truth_fixed,
        error_vec=alpha_list
    )

    for alpha, beta_val in zip(alpha_list, power_bn_vec):
        attack_rows.append({
            "exp_name": exp_name,
            "M": n_nodes_cur,
            "E": E_cur,
            "n_arcs": n_arcs_cur,
            "complexity": complexity_cur,
            "model": "BN",
            "privacy_param_name": "none",
            "privacy_param": 0.0,
            "privacy_label": "BN",
            "alpha": float(alpha),
            "beta": float(beta_val),
            "auc": float(auc_bn),
        })

    pd.DataFrame({"llr_ref": llr_ref_bn}).to_csv(
        exp2_detail_path / f"{exp_name}_bn_llr_ref.csv", index=False
    )
    pd.DataFrame({"llr_gen": llr_gen_bn, "ground_truth": ground_truth_fixed}).to_csv(
        exp2_detail_path / f"{exp_name}_bn_llr_gen.csv", index=False
    )

    # noisy BN sweep
    for eps_val in eps_grid:
        print(f"[Exp2] noisy BN attack, eps={eps_val} ...")

        scale = (2 * bn_learned.size()) / (len(train_df) * eps_val)
        bn_noisy = get_noisy_bn(bn_learned, scale)

        bn_noisy_ie = gum.LazyPropagation(bn_noisy)
        power_noisy_vec, auc_noisy, _, _ = run_mia(
            model_ie=bn_noisy_ie,
            baseline_ie=bn_ref_ie,
            rpop=ref_df,
            gpop_eval=gpop_eval_vars,
            ground_truth=ground_truth_fixed,
            error_vec=alpha_list
        )

        for alpha, beta_val in zip(alpha_list, power_noisy_vec):
            attack_rows.append({
                "exp_name": exp_name,
                "M": n_nodes_cur,
                "E": E_cur,
                "n_arcs": n_arcs_cur,
                "complexity": complexity_cur,
                "model": "noisyBN",
                "privacy_param_name": "eps",
                "privacy_param": float(eps_val),
                "privacy_label": f"eps={eps_val}",
                "alpha": float(alpha),
                "beta": float(beta_val),
                "auc": float(auc_noisy),
            })

    # CN sweep
    for ess_val in ess_grid:
        print(f"[Exp2] CN attack, ESS={ess_val} ...")

        bn_copy = gum.BayesNet(bn_learned)
        add_counts_to_bn(bn_copy, train_df)

        cn_model = gum.CredalNet(bn_copy)
        cn_model.idmLearning(ess_val)

        bns_sample = sample_from_cn(cn_model, n=n_bns_from_cn, where="inside")
        best_bn = get_maxll_bn(bns_sample, ref_df)
        best_bn_ie = gum.LazyPropagation(best_bn)

        power_cn_vec, auc_cn, _, _ = run_mia(
            model_ie=best_bn_ie,
            baseline_ie=bn_ref_ie,
            rpop=ref_df,
            gpop_eval=gpop_eval_vars,
            ground_truth=ground_truth_fixed,
            error_vec=alpha_list
        )

        for alpha, beta_val in zip(alpha_list, power_cn_vec):
            attack_rows.append({
                "exp_name": exp_name,
                "M": n_nodes_cur,
                "E": E_cur,
                "n_arcs": n_arcs_cur,
                "complexity": complexity_cur,
                "model": "CN",
                "privacy_param_name": "ess",
                "privacy_param": float(ess_val),
                "privacy_label": f"S={ess_val}",
                "alpha": float(alpha),
                "beta": float(beta_val),
                "auc": float(auc_cn),
            })

    # ----- save attack results -----
    attack_df = pd.DataFrame(attack_rows)
    attack_file = exp2_path / f"{exp_name}_exp2_attack_results.csv"
    attack_df.to_csv(attack_file, index=False)

    # ----- merge utility -----
    attack_df["model"] = attack_df["model"].astype(str)
    attack_df["privacy_param_name"] = attack_df["privacy_param_name"].astype(str)
    attack_df["privacy_param"] = attack_df["privacy_param"].astype(float)

    exp2_df = attack_df.merge(
        utility_df,
        on=["model", "privacy_param_name", "privacy_param"],
        how="left"
    )

    missing_utility = exp2_df[exp2_df["mae"].isna()].copy()
    if len(missing_utility) > 0:
        print("[Warning] 以下攻击配置没有匹配到实验一效用结果：")
