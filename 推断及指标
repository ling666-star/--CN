def posterior_prob_bn(bn_model, target_var, target_val, evidence):
    ie = gum.LazyPropagation(bn_model)
    ie.setEvidence(evidence)
    ie.makeInference()
    post = ie.posterior(target_var)
    return float(post[target_val])


def map_state_bn(bn_model, target_var, evidence):
    ie = gum.LazyPropagation(bn_model)
    ie.setEvidence(evidence)
    ie.makeInference()
    post = ie.posterior(target_var)
    arr = np.array(post[:], dtype=float)
    return int(np.argmax(arr)), float(np.max(arr))


# ---------------------------------------------------------
# 10.3 Helper: build one query from one row in Q
# ---------------------------------------------------------

def sample_query_from_row(row, columns, rng, min_evi=1, max_evi=3):
    target_var = rng.choice(columns)

    candidate_evi = [c for c in columns if c != target_var]
    max_evi = min(max_evi, len(candidate_evi))
    n_evi = rng.randint(min_evi, max_evi)

    evidence_vars = rng.sample(candidate_evi, n_evi)
    evidence = {v: int(row[v]) for v in evidence_vars}

    target_val = int(row[target_var])

    return target_var, target_val, evidence_vars, evidence


# ---------------------------------------------------------
# 10.4 CN interval by Monte Carlo sampling
# ---------------------------------------------------------

def posterior_interval_cn_mc(
    cn,
    target_var,
    target_val,
    evidence,
    max_iter=500,
    max_time=20,
    epsilon=1e-4,
):
    ie = gum.CNMonteCarloSampling(cn)
    ie.setEvidence(evidence)

    ie.setMaxIter(max_iter)
    ie.setMaxTime(max_time)
    ie.setEpsilon(epsilon)

    ie.makeInference()

    lower_dist = ie.marginalMin(target_var)
    upper_dist = ie.marginalMax(target_var)

    lower = float(lower_dist[target_val])
    upper = float(upper_dist[target_val])

    return lower, upper


