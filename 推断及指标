# 11.4 ICE (Interval Calibration Error)
#     按 cn_mid 分箱
# ---------------------------------------------------------

def compute_ice(df, n_bins=10):
    """
    ICE:
    1. 按 CN 区间中点 cn_mid 分箱
    2. 每个箱内计算：
       - 平均预测区间 [avg_lower, avg_upper]
       - 平均真实后验 avg_gt
    3. 若 avg_gt 落在 [avg_lower, avg_upper] 内，偏差 = 0
       否则偏差 = 到区间最近端点的距离
    4. 整体 ICE = 分箱偏差的加权平均
    """
    work = df.copy()

    # 避免 pd.cut 在重复边界时报错
    work["bin"] = pd.cut(
        work["cn_mid"],
        bins=n_bins,
        labels=False,
        include_lowest=True,
        duplicates="drop"
    )

    total_n = len(work)
    ice = 0.0
    bin_details = []

    for b, grp in work.groupby("bin", dropna=True):
        if len(grp) == 0:
            continue

        avg_lower = grp["cn_lower"].mean()
        avg_upper = grp["cn_upper"].mean()
        avg_gt = grp["gt_prob"].mean()

        if avg_gt < avg_lower:
            dev = avg_lower - avg_gt
        elif avg_gt > avg_upper:
            dev = avg_gt - avg_upper
        else:
            dev = 0.0

        weight = len(grp) / total_n
        ice += weight * dev

        bin_details.append({
            "bin": int(b),
            "count": len(grp),
            "avg_cn_mid": grp["cn_mid"].mean(),
            "avg_cn_lower": avg_lower,
            "avg_cn_upper": avg_upper,
            "avg_gt_prob": avg_gt,
            "bin_dev": dev,
            "weight": weight,
            "weighted_dev": weight * dev,
        })

    bin_df = pd.DataFrame(bin_details)
    return ice, bin_df


