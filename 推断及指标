# 10.7 Worker: each process loads models once, then handles a chunk
# ---------------------------------------------------------

def run_query_chunk(
    chunk,
    gt_bn_path_str,
    learned_bn_path_str,
    noisy_bn_path_str,
    train_path_str,
    ess,
    max_iter,
    max_time,
    epsilon,
):
    import pyagrum as gum
    import pandas as pd
    import numpy as np

    # ---- local helpers inside worker ----
    def posterior_prob_bn_local(bn_model, target_var, target_val, evidence):
        ie = gum.LazyPropagation(bn_model)
        ie.setEvidence(evidence)
        ie.makeInference()
        post = ie.posterior(target_var)
        return float(post[target_val])

    def map_state_bn_local(bn_model, target_var, evidence):
        ie = gum.LazyPropagation(bn_model)
        ie.setEvidence(evidence)
        ie.makeInference()
        post = ie.posterior(target_var)
        arr = np.array(post[:], dtype=float)
        return int(np.argmax(arr)), float(np.max(arr))

    def posterior_interval_cn_mc_local(
        cn,
        target_var,
        target_val,
        evidence,
        max_iter,
        max_time,
        epsilon,
    ):
        ie = gum.CNMonteCarloSampling(cn)
        ie.setEvidence(evidence)
        ie.setMaxIter(max_iter)
        ie.setMaxTime(max_time)
        ie.setEpsilon(epsilon)
        ie.makeInference()

        lower_dist = ie.marginalMin(target_var)
        upper_dist = ie.marginalMax(target_var)

        lower = float(lower_dist[target_val])
        upper = float(upper_dist[target_val])
        return lower, upper

    # ---- load models once per process call ----
    gt_bn = gum.loadBN(gt_bn_path_str)
    learned_bn = gum.loadBN(learned_bn_path_str)
    noisy_bn = gum.loadBN(noisy_bn_path_str)

    train_df_local = pd.read_csv(train_path_str)
    bn_copy = gum.BayesNet(learned_bn)
    add_counts_to_bn(bn_copy, train_df_local)

    cn = gum.CredalNet(bn_copy)
    cn.idmLearning(ess)

    local_results = []

    for q in chunk:
        qid = q["query_id"]
        row_idx = q["row_id"]
        target_var = q["target_var"]
        target_val = q["target_val"]
        evidence_vars = q["evidence_vars"]
        evidence = q["evidence"]

        # --- true posterior from ground-truth BN
        gt_prob = posterior_prob_bn_local(gt_bn, target_var, target_val, evidence)
        gt_map, gt_map_prob = map_state_bn_local(gt_bn, target_var, evidence)

        # --- learned BN
        bn_prob = posterior_prob_bn_local(learned_bn, target_var, target_val, evidence)
        bn_map, bn_map_prob = map_state_bn_local(learned_bn, target_var, evidence)

        # --- noisy BN
        noisy_prob = posterior_prob_bn_local(noisy_bn, target_var, target_val, evidence)
        noisy_map, noisy_map_prob = map_state_bn_local(noisy_bn, target_var, evidence)

        # --- CN interval
        cn_lower, cn_upper = posterior_interval_cn_mc_local(
            cn=cn,
            target_var=target_var,
            target_val=target_val,
            evidence=evidence,
            max_iter=max_iter,
            max_time=max_time,
            epsilon=epsilon,
        )
        if cn_lower > cn_upper:
            cn_lower, cn_upper = cn_upper, cn_lower
        cn_mid = 0.5 * (cn_lower + cn_upper)

        local_results.append({
            "query_id": qid,
            "row_id": row_idx,
            "target_var": target_var,
            "target_val": target_val,
            "evidence_vars": "|".join(evidence_vars),
            "evidence_vals": "|".join([str(evidence[v]) for v in evidence_vars]),

            "gt_prob": gt_prob,
            "gt_map": gt_map,
            "gt_map_prob": gt_map_prob,

            "bn_prob": bn_prob,
            "bn_map": bn_map,
            "bn_map_prob": bn_map_prob,

            "noisy_prob": noisy_prob,
            "noisy_map": noisy_map,
            "noisy_map_prob": noisy_map_prob,

            "cn_lower": cn_lower,
            "cn_upper": cn_upper,
            "cn_mid": cn_mid,
            "cn_width": cn_upper - cn_lower,
            "cn_contains_gt": int(cn_lower <= gt_prob <= cn_upper),
        })

    return local_results


