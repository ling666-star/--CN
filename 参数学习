from itertools import product

def check_counts_for_node(bn_counts, data, target):
    """
    检查 add_counts_to_bn 写入 bn_counts 的 counts 是否和 pandas 直接统计一致。
    """

    target_id = bn_counts.idFromName(target)
    parent_ids = list(bn_counts.parents(target_id))
    parent_names = [bn_counts.variable(pid).name() for pid in parent_ids]

    print(f"\n检查 counts: {target} | {parent_names}")

    parent_domains = [
        range(bn_counts.variable(pid).domainSize())
        for pid in parent_ids
    ]

    target_domain = range(bn_counts.variable(target_id).domainSize())

    all_ok = True

    for parent_vals in product(*parent_domains):
        parent_assign = dict(zip(parent_names, parent_vals))

        for target_val in target_domain:
            assign = dict(parent_assign)
            assign[target] = target_val

            # pyAgrum CPT 里的 count
            gum_count = float(bn_counts.cpt(target)[assign])

            # pandas 直接统计的 count
            mask = data[target].astype(int).eq(target_val)
            for p, v in parent_assign.items():
                mask = mask & data[p].astype(int).eq(v)

            pd_count = float(mask.sum())

            if abs(gum_count - pd_count) > 1e-9:
                all_ok = False
                print("不一致:")
                print("assign =", assign)
                print("gum_count =", gum_count)
                print("pd_count  =", pd_count)

    if all_ok:
        print(f"{target} counts 检查通过。")

    return all_ok

