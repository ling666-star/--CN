# Log-likelihood function
def get_ll(x: dict, theta):
    theta.setEvidence(x)
    ll = theta.evidenceProbability()
    return np.log(ll)


# Log-likelihood ratio (llr) function
def get_llr(x: dict, theta, theta_hat):
    ll_theta = get_ll(x, theta)
    ll_theta_hat = get_ll(x, theta_hat)
    return ll_theta_hat - ll_theta


# Parse the credal network
def parse_cn(cn) -> tuple:
    dag = gum.BayesNet(cn.current_bn())

    buffer = io.StringIO()
    with redirect_stdout(buffer):
        print(cn)
    cn_str = buffer.getvalue()

    credal_dict = defaultdict(lambda: defaultdict(list))
    current_var = None
    lines = cn_str.strip().split("\n")

    for line in lines:
        line = line.strip()

        var_match = re.match(r"^([A-Za-z0-9_]+):", line)
        if var_match:
            current_var = var_match.group(1)
            continue

        if current_var is None or not line:
            continue

        cpt_match = re.match(r"^<([^>]*)>\s*:\s*(.*)", line)
        if cpt_match:
            condition = f"<{cpt_match.group(1).strip()}>"
            raw_cpt = cpt_match.group(2)

            vectors = re.findall(r"\[\s*([^\[\]]+?)\s*\]", raw_cpt)
            for vec in vectors:
                prob_vec = [float(x.strip()) for x in vec.split(",")]
                credal_dict[current_var][condition].append(prob_vec)

    params = []
    for var in credal_dict:
        for cond, vectors in credal_dict[var].items():
            params.append((var, cond, vectors))

    return dag, params


# Given a parsed CN called `params`, sample a BN inside the credal set
def sample_inside(params):
    p_1 = [
        (vecs[0][0] - vecs[1][0]) * random_sample() + vecs[1][0]
        for _, _, vecs in params
    ]
    p = [[x, 1 - x] for x in p_1]
    yield p


# Given a parsed CN called `params`, sample a vertex of the credal set
def sample_outside(params):
    yield random_product(*[vecs for _, _, vecs in params])


# Compute a random subset of BNs from the CN
def sample_from_cn(cn, n: int, where: str) -> list:
    np.random.seed(42)

    dag, params = parse_cn(cn)

    var_idx = {
        var: [idx for idx, elem in enumerate(params) if elem[0] == var]
        for var in dag.names()
    }

    if where == "inside":
        sample = sample_inside
    elif where == "outside":
        sample = sample_outside
    else:
        raise ValueError("'where' can be either 'inside' or 'outside'")

    k = 0
    bns = []
    while k < n:
        bn_tmp = gum.BayesNet(dag)
        next_sample = next(sample(params))

        for var in dag.names():
            array = np.array([(next_sample[idx]) for idx in var_idx.get(var)]).flatten()
            bn_tmp.cpt(var).fillWith(array)

        bns.append(bn_tmp)
        k += 1

    return bns


# Check BNs sampled from a CN
def are_all_bns_different(bn_vec) -> None:
    signatures = set()
    for bn_tmp in bn_vec:
        cpt_data = []
        for var in bn_tmp.names():
            cpt = bn_tmp.cpt(var)
            flat = [f"{v:.8f}" for v in cpt.toarray().flatten()]
            cpt_data.append(f"{var}:" + ",".join(flat))
        sig = "|".join(cpt_data)
        signatures.add(sig)

    print(f"({len(signatures)}/{len(bn_vec)} different BNs.)")




def add_counts_to_bn(bn_in, data):
    """
    Add empirical event counts from data to a BN.

    Important:
    - This function only changes CPT values.
    - It does NOT add/remove arcs.
    - After this function, bn_in.cpt(node) stores counts, not probabilities.
    - It writes CPT cells by variable-name assignment, so it avoids
      parent-order / flatten-order mismatch.
    """

    # 检查 data 是否包含所有 BN 变量列
    missing_cols = set(bn_in.names()) - set(data.columns)
    if missing_cols:
        raise ValueError(f"data 缺少 BN 变量列: {missing_cols}")

    # 先把所有 CPT 清零
    for node_name in bn_in.names():
        bn_in.cpt(node_name).fillWith(0.0)

    # 逐行统计 counts
    for _, row in data.iterrows():

        for node_name in bn_in.names():
            node_id = bn_in.idFromName(node_name)
            node_var = bn_in.variable(node_id)

            try:
                node_val = int(row[node_name])
            except Exception:
                continue

            # 检查当前节点状态是否合法
            if node_val < 0 or node_val >= node_var.domainSize():
                continue

            assign = {
                node_name: node_val
            }

            valid = True

            # 父节点赋值
            for parent_id in bn_in.parents(node_id):
                parent_name = bn_in.variable(parent_id).name()
                parent_var = bn_in.variable(parent_id)

                try:
                    parent_val = int(row[parent_name])
                except Exception:
                    valid = False
                    break

                if parent_val < 0 or parent_val >= parent_var.domainSize():
                    valid = False
                    break

                assign[parent_name] = parent_val

            if not valid:
                continue

            # 关键：按变量名写入，不用 flatten
            bn_in.cpt(node_name)[assign] += 1.0

    return bn_in



# Create noisy BN by adding Laplacian noise
def get_noisy_bn(bn_in, scale: float):
    bn_ie = gum.LazyPropagation(bn_in)
    bn_ie.makeInference()

    bn_noisy_local = gum.BayesNet(bn_in)

    for node in bn_in.names():
        joint = bn_ie.jointPosterior(bn_in.family(node))

        noise = np.random.laplace(scale=scale, size=np.prod(joint.shape))
        noisy_joint = np.clip(
            joint.toarray().flatten() + noise,
            a_min=1e-9,
            a_max=None
        )
        noisy_joint = noisy_joint / np.sum(noisy_joint)
        joint.fillWith(noisy_joint)

        cond = joint / joint.sumOut(node)
        bn_noisy_local.cpt(node).fillWith(cond)

    bn_noisy_local.check()
    return bn_noisy_local


